# Copy this file to .env for local development. NEVER commit the real .env.
# Must start with postgresql+asyncpg:// (the async driver your code uses)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/tasks_api
JWT_SECRET_KEY=replace-with-a-long-random-string
# Comma-separated frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
